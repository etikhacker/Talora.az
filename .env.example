# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (Free Plan) Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Vercel Supabase integration aliases are also supported by the app.
# If these are present, Next.js exposes only the URL and publishable key to the browser.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Required for server-side email notifications to read student preferences and addresses.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gmail SMTP notifications (server-only; use a Google App Password, never your account password)
GMAIL_USER="internaz.notification@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-google-app-password"

# Gmail delivery transport (server only, never prefix these with NEXT_PUBLIC_)
# "smtp" preserves the existing behavior. Enable "api" only AFTER OAuth setup
# and a safe end-to-end test; an incomplete configuration fails closed.
GMAIL_DELIVERY_PROVIDER="smtp"

# Gmail API OAuth 2.0 (only used when GMAIL_DELIVERY_PROVIDER="api")
# Register an OAuth client in Google Cloud, grant only gmail.send (least privilege).
# These values are secrets: enter them in Vercel Production env, not in Git.
# GMAIL_OAUTH_CLIENT_ID="example.apps.googleusercontent.com"
# GMAIL_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
# GMAIL_OAUTH_REFRESH_TOKEN="your-offline-refresh-token"
