# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Courses is disabled by default in every environment, including previews.
# Enable only against a verified database with the Courses migration applied.
# Do not enable on a preview connected to unverified production Supabase.
NEXT_PUBLIC_COURSES_ENABLED="false"

# Supabase (Free Plan) Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Vercel Supabase integration aliases are also supported by the app.
# If these are present, Next.js exposes only the URL and publishable key to the browser.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Required for server-side email notifications to read student preferences and addresses.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gmail SMTP notifications (server-only; use a Google App Password, never your account password)
GMAIL_USER="internaz.notification@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-google-app-password"
